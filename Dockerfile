# syntax=docker/dockerfile:1

# ---- build ---------------------------------------------------------------
# Full devDependencies are required: vite.config.ts imports from `vitest/config`
# and `@vitest/browser-playwright`, so a production build still loads them.
FROM node:24-alpine AS build
WORKDIR /app

# Playwright's postinstall would download browsers (~unsupported on musl, and
# useless in an image that never runs e2e tests).
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

COPY package.json package-lock.json ./
RUN npm ci

# `src/lib/paraglide/` is generated by the paraglide Vite plugin from
# `messages/` + `project.inlang/` at build time — both must be in the context.
COPY . .
RUN npm run build && npm prune --omit=dev

# ---- runtime -------------------------------------------------------------
FROM node:24-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000

COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/build ./build

USER node
EXPOSE 3000

# adapter-node has no /health route of its own; `/` is SSR'd and cheap enough.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
    CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1

CMD ["node", "build"]
